{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	// Developer-only tooling (benchmark harnesses, parser A/B rig, spike
	// prototypes) is intentionally excluded: it is not shipped and its
	// exports are consumed by ad-hoc scripts, not by the app.
	"ignore": [
		"scripts/parser-ab/**",
		"scripts/*.mjs",
		"scripts/bench-*.mjs",
		"scripts/bench-ingest.mjs",
		"scripts/bench-retrieval.mjs",
		"scripts/compare-private-runs.ts",
		"scripts/doclayout-probe.ts",
		"scripts/dump-parsed-document.ts",
		"scripts/intent-calibration.ts",
		"scripts/private-run-scoring.ts",
		"scripts/rescore-private-run.ts",
		"scripts/retrieval-metrics-report.ts",
		"scripts/build-og-image.mjs",
		"src/lib/benchmark/**",
		"src/lib/nlu/intent-prototypes.ts",
		// Consumed by the dev pipeline route via dynamic type imports that
		// knip's Svelte analysis does not resolve.
		"src/lib/state/documents.svelte.ts",
		"src/lib/components/ui/**",
		"src/lib/index.ts"
	],
	"ignoreDependencies": [
		// Consumed by the install-time vendor script (copies the sqlite wasm
		// build into static/vendor), not by app code — knip cannot see it.
		"sqlite-vec-wasm-demo",
		// Not imported anywhere: better-auth, drizzle and superforms all peer-
		// depend on zod, and bun hoists whichever range it resolves first. The
		// direct dependency pins one v4 copy for all of them (PROGRESS
		// 2026-07-08: a v3/v4 split broke better-auth at runtime).
		"zod",
		// Referenced from .releaserc.json; knip's semantic-release analysis
		// resolves some plugins but not these four.
		"@semantic-release/commit-analyzer",
		"@semantic-release/release-notes-generator",
		"@semantic-release/npm",
		"@semantic-release/github"
	]
}
