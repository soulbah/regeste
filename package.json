{
	"name": "folio",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"license": "AGPL-3.0-only",
	"engines": {
		"node": ">=22 <23"
	},
	"packageManager": "bun@1.2.22",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "bun run build && wrangler dev",
		"prepare": "svelte-kit sync && bun run vendor || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"verify": "bun run check && bun run lint && bun run test && bun run build",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply folio-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply folio-db --remote",
		"cf:types": "wrangler types && sed -i '' 's#typeof import(\"./.svelte-kit/cloudflare/_worker\")#unknown#' worker-configuration.d.ts",
		"deploy": "bun run build && bunx wrangler@4.106.0 deploy",
		"knip": "knip",
		"vendor": "mkdir -p static/vendor/sqlite && cp node_modules/sqlite-vec-wasm-demo/sqlite3.mjs node_modules/sqlite-vec-wasm-demo/sqlite3.wasm static/vendor/sqlite/"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.18.2",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.2.9",
		"@fontsource-variable/geist-mono": "^5.2.8",
		"@fontsource-variable/newsreader": "^5.2.10",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.23.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"formsnap": "^2.0.1",
		"globals": "^17.6.0",
		"knip": "^6.25.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.4.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.107.1"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.2.0",
		"@mlc-ai/web-llm": "^0.2.84",
		"better-auth": "^1.6.23",
		"comlink": "^4.4.2",
		"drizzle-orm": "^0.45.2",
		"mammoth": "^1.12.0",
		"pdfjs-dist": "^6.1.200",
		"sqlite-vec-wasm-demo": "0.1.7-alpha.2",
		"valibot": "^1.4.2",
		"zod": "^4"
	},
	"trustedDependencies": [
		"esbuild",
		"sharp",
		"workerd"
	]
}
