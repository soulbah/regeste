{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "regeste",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Production hostnames. Routes rather than custom_domain on purpose: a route
	// intercepts at the edge without touching the zone's DNS, so removing it puts
	// the previous record back and the change is reversible in one deploy. The
	// apex and www both point here, and hooks.server.ts sends www to the apex —
	// two live origins would mean two cookie jars, and anyone who signed in on one
	// would look signed out on the other.
	//
	// workers.dev is off, and wrangler did that on its own: declaring routes
	// without an explicit "workers_dev": true disables it. That is the right end
	// state — a second origin serving the same app is a duplicate for search
	// engines and another place where sessions work — but it happened in the same
	// deploy as the route rather than after it, so there was no fallback origin
	// while the route settled. Set "workers_dev": true here if one is ever needed
	// again for staging.
	"routes": [
		{ "pattern": "regeste.com/*", "zone_name": "regeste.com" },
		{ "pattern": "www.regeste.com/*", "zone_name": "regeste.com" }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "regeste-db",
			"database_id": "762f3c84-08d2-444c-9e47-7ba0c654d159",
			"migrations_dir": "migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	// Cloudflare Email Service, enabled on the mail.regeste.com subdomain: codes
	// go out through this binding rather than a third-party sender, which is
	// what the constitution's Cloudflare-first rule asks for. The zone's
	// DKIM, SPF, DMARC and bounce records were created when sending was
	// enabled; `wrangler email sending dns get regeste.com` prints them.
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["login@mail.regeste.com"]
		}
	],
	"vars": {
		// This hosted deployment offers the Cloud mode (maintainer-funded). A
		// self-hosted build without this variable is This device + Your server
		// only, no backend — see src/lib/flags.ts.
		"PUBLIC_ASSISTED_ENABLED": "true"
	}
	// Enabled by later specs (see docs/FEATURES.md):
	// "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
	// Secrets (never in this file): wrangler secret put BETTER_AUTH_SECRET / TURNSTILE_SECRET_KEY
}
