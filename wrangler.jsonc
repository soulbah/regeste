{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "regeste",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "regeste-db",
			"database_id": "762f3c84-08d2-444c-9e47-7ba0c654d159",
			"migrations_dir": "migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	// Cloudflare Email Service, enabled on the mail.regeste.com subdomain: codes
	// go out through this binding rather than a third-party sender, which is
	// what the constitution's Cloudflare-first rule asks for. The zone's
	// DKIM, SPF, DMARC and bounce records were created when sending was
	// enabled; `wrangler email sending dns get regeste.com` prints them.
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["login@mail.regeste.com"]
		}
	],
	"vars": {
		// This hosted deployment offers the Cloud mode (maintainer-funded). A
		// self-hosted build without this variable is This device + Your server
		// only, no backend — see src/lib/flags.ts.
		"PUBLIC_ASSISTED_ENABLED": "true"
	}
	// Enabled by later specs (see docs/FEATURES.md):
	// "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
	// Secrets (never in this file): wrangler secret put BETTER_AUTH_SECRET / TURNSTILE_SECRET_KEY
}
